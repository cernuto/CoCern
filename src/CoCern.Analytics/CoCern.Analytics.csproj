    <ProjectReference Include="../CoCern.Contracts/CoCern.Contracts.csproj" />
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <EmbeddedResource Include="Views.sql" LogicalName="CoCern.Analytics.Views.sql" />
    <InternalsVisibleTo Include="CoCern.Tests" />
  </ItemGroup>
</Project>
