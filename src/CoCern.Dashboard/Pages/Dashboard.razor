@page "/"
@page "/sessions"
@page "/sql"
@page "/logs"
@page "/standing"
@page "/documents"

<PageTitle>@PageTitle · CoCern</PageTitle>
@if (Connection.State == DashboardLinkState.SignIn)
{
    <SignIn Notice="@Connection.Notice" OnSignIn="SignInAsync" />
}
else if (!Connection.Authenticated)
{
    <main class="connection-splash"><div class="relay-mark" aria-hidden="true">Co</div><h1>Connecting…</h1><p>@(Connection.Notice ?? "Checking access to this hub.")</p><span class="muted">Retrying automatically.</span></main>
}
else
{
    <div class="dashboard-shell">
        <a class="skip-link" href="#main">Skip to content</a>
        <header class="app-header">
            <a class="brand" href="./" aria-label="CoCern overview"><span class="relay-mark" aria-hidden="true">Co</span><span>CoCern</span></a>
            <nav class="main-nav" aria-label="Dashboard">
                <NavLink href="" Match="NavLinkMatch.All"><Icon Name="overview" />Overview</NavLink>
                <NavLink href="sessions"><Icon Name="sessions" />Sessions</NavLink>
                <NavLink href="sql"><Icon Name="database" />Database</NavLink>
                <NavLink href="logs"><Icon Name="logs" />Logs</NavLink>
                <NavLink href="standing"><Icon Name="standing" />Standing</NavLink>
                <NavLink href="documents"><Icon Name="documents" />Documents</NavLink>
            </nav>
            <div class="header-actions">
                <button type="button" class="icon-button" @onclick="ToggleThemeAsync" aria-label="@(_theme == "dark" ? "Use light appearance" : "Use dark appearance")" title="@(_theme == "dark" ? "Light appearance" : "Dark appearance")"><Icon Name="@(_theme == "dark" ? "sun" : "moon")" /></button>
                <button type="button" class="icon-button" @onclick="SignOutAsync" disabled="@_signingOut" aria-label="Sign out" title="Sign out"><Icon Name="sign-out" /></button>
            </div>
        </header>
        <main id="main" class="dashboard-main">
            <div class="page-heading">
                <div><h1>@PageTitle</h1>@if (PageDescription is { } description) { <p>@description</p> }</div>
                <div class="connection-status"><span class="connection-chip @(IsLive ? "live" : "waiting")" role="status"><span class="status-dot"></span>@ConnectionLabel</span><span title="@DashboardFormat.Timestamp(Connection.Snapshot?.ObservedAt)">Updated @DashboardFormat.Ago(Connection.Snapshot?.ObservedAt, _now).ToLowerInvariant()</span></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Connection.Notice))
            {
                <p class="connection-notice" role="status">@Connection.Notice</p>
            }
            @if (Connection.Snapshot is { } snapshot)
            {
                <section class="relay-summary" aria-label="Relay summary">
                    <div class="host-summary"><span class="host-symbol" aria-hidden="true"><Icon Name="machine" Size="20" /></span><span><strong>@snapshot.Host.Name</strong><small>CoCern @snapshot.Host.Version</small></span></div>
                    <div class="summary-stat"><strong>@snapshot.Host.MachineCount</strong><span title="Machines enrolled with this hub">Enrolled</span></div>
                    <div class="summary-stat"><strong>@snapshot.Host.SessionCount</strong><span>@(snapshot.Host.SessionCount == 1 ? "Session" : "Sessions")</span></div>
                    <div class="summary-stat"><strong>@snapshot.Host.ReachableCount</strong><span>Reachable</span></div>
                </section>
                @if (snapshot.Warnings.Length > 0)
                {
                    <details class="observation-warnings"><summary>@snapshot.Warnings.Length @(snapshot.Warnings.Length == 1 ? "notice" : "notices")</summary><ul>@foreach (var warning in snapshot.Warnings) { <li>@warning</li> }</ul></details>
                }
                @if (snapshot.SessionsTruncated && View is "overview" or "sessions")
                {
                    <p class="limit-note">Showing @snapshot.Sessions.Length of @snapshot.Host.SessionCount sessions.</p>
                }
                @switch (View)
                {
                    case "documents":
                        <DocCacheView Cache="@snapshot.DocCache" Now="@_now" />
                        break;
                    case "sessions":
                        <div class="board-layout"><SessionList Sessions="@snapshot.Sessions" SelectedId="@_selectedId" OnSelect="SelectSession" Now="@_now" Truncated="@snapshot.SessionsTruncated" /><SessionInspector Session="@SelectedSession" Logs="@snapshot.Logs" Now="@_now" /></div>
                        <TrafficLane Entries="@snapshot.Traffic" Sessions="@snapshot.Sessions" SelectedSession="@SelectedSession" InstanceId="@snapshot.InstanceId" Now="@_now" Live="@IsLive" />
                        break;
                    case "sql":
                        <SqlView Metrics="@snapshot.Database" Now="@_now" />
                        break;
                    case "logs":
                        <LogView Entries="@snapshot.Logs" />
                        break;
                    case "standing":
                        <StandingView Boards="@snapshot.Standing" Truncated="@snapshot.StandingTruncated" Tokens="@snapshot.Tokens" Now="@_now" />
                        break;
                    default:
                        <div class="overview-layout">
                            <div class="overview-board"><ActivityBoard Snapshot="@snapshot" SelectedId="@_selectedId" OnSelect="SelectSession" Now="@_now" Live="@IsLive" IsPulsing="Pulse" /></div>
                            <div class="overview-inspector"><SessionInspector Session="@SelectedSession" Logs="@snapshot.Logs" Now="@_now" /></div>
                            <div class="overview-traffic"><TrafficLane Entries="@snapshot.Traffic" Sessions="@snapshot.Sessions" SelectedSession="@SelectedSession" InstanceId="@snapshot.InstanceId" Now="@_now" Live="@IsLive" /></div>
                        </div>
                        <LogView Entries="@snapshot.Logs" Compact />
                        break;
                }
                <footer class="app-footer"><span>Read-only · @Connection.PrincipalId</span><span>Hub started @DashboardFormat.Timestamp(snapshot.Host.StartedAt)</span></footer>
            }
            else
            {
                <section class="surface waiting-snapshot"><Icon Name="empty" Size="28" /><h2>Waiting for the hub</h2><p>Machines and sessions appear with the first update.</p></section>
            }
        </main>
    </div>
}


