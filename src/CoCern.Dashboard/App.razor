<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Page not found · CoCern</PageTitle>
        <main class="not-found"><h1>That page isn't here.</h1><a href="./">Open the dashboard</a></main>
    </NotFound>
</Router>
