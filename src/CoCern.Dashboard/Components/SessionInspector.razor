<aside class="session-inspector surface" aria-labelledby="inspector-heading">
    <div class="section-heading"><h2 id="inspector-heading">Session</h2></div>
    @if (Session is null)
    {
        <div class="inspector-empty"><Icon Name="sessions" Size="28" /><h3>No session selected</h3><p>Select one to see its details.</p></div>
    }
    else
    {
        <div class="inspector-title"><span class="provider-token" aria-hidden="true">@ProviderInitial</span><div><h3>@Session.Label</h3><p title="@Session.SessionId">@Session.Provider · #@ShortId(Session.SessionId)</p></div></div>
        <div class="tag-row">
            <BbBadge Variant="@(Session.Reachable ? BadgeVariant.SoftInfo : BadgeVariant.Secondary)" title="Whether the hub has a current direct route to wake this chat. MCP calls and inbox communication can still work without one. This does not indicate whether a model is running.">@(Session.Reachable ? "Direct chat route available" : "No direct chat route")</BbBadge>
            @if (Session.HasBindingReport is null)
            {
                <BbBadge Variant="BadgeVariant.Outline">Tool binding not reported</BbBadge>
            }
            else if (Session.HasBindingReport == false)
            {
                <BbBadge Variant="BadgeVariant.Outline">No tool binding reported</BbBadge>
            }
            else
            {
                <BbBadge Variant="BadgeVariant.Outline" title="Freshness of reported binding metadata, not a verified IDE connection. Relay calls do not renew this report.">Report: @DashboardFormat.Freshness(Session, Now)</BbBadge>
            }
        </div>
        <dl class="session-facts">
            <div><dt>Machine</dt><dd>@MachineLabel</dd></div>
            <div><dt>Repository</dt><dd>@(string.IsNullOrWhiteSpace(Session.RepositoryId) ? "Not reported" : Session.RepositoryId)</dd></div>
            <div><dt title="Whether discovery reported a provider mapping for this chat's direct route.">Chat route mapping</dt><dd>@(Session.IsMapped ? "Reported" : "Not reported")</dd></div>
            <div><dt>Opened</dt><dd>@(Session.OpenedAt is { } opened ? DashboardFormat.Timestamp(opened) : "Opened time unavailable")</dd></div>
            <div><dt>Status report</dt><dd title="@DashboardFormat.Timestamp(Session.ReportedAt)">@DashboardFormat.Ago(Session.ReportedAt, Now)</dd></div>
            <div><dt>Report fresh until</dt><dd>@DashboardFormat.Timestamp(Session.FreshUntil)</dd></div>
            <div><dt title="Most recent recorded successful tool call, including background polling. This does not indicate whether a model is running.">Last relay call</dt><dd title="@DashboardFormat.Timestamp(Session.LastActivityAt)">@DashboardFormat.Ago(Session.LastActivityAt, Now)</dd></div>
        </dl>
        <div class="inspector-counts"><BbCard><strong>@DashboardFormat.Count(Session.UnreadMessages)</strong><span>Unread messages</span></BbCard><BbCard><strong>@DashboardFormat.Count(Session.PendingEffects)</strong><span>Pending effects</span></BbCard></div>
        <SessionToolSettingsControl @key="(typeof(SessionToolSettingsControl), Session.SessionId)" Session="@Session" />
        <CloseSessionControl @key="Session.SessionId" Session="@Session" />
        <details class="session-identifiers"><summary>Session ID</summary><p>@Session.SessionId</p></details>
        <div class="inspector-events"><h3>Recent log</h3>
            @if (SessionLogEntries.Length == 0)
            {
                <p class="muted">Nothing recent.</p>
            }
            @foreach (var entry in SessionLogEntries)
            {
                <div class="inspector-event" @key="entry.Sequence"><time title="@DashboardFormat.Timestamp(entry.Timestamp)">@DashboardFormat.Ago(entry.Timestamp, Now)</time><p>@entry.Message</p></div>
            }
        </div>
    }
</aside>

@code {
    [Parameter] public DashboardSession? Session { get; set; }
    [Parameter] public DashboardLogEntry[] Logs { get; set; } = [];
    [Parameter] public DateTimeOffset Now { get; set; }
    private static string ShortId(string id) => id[..Math.Min(8, id.Length)];
    private string ProviderInitial => string.IsNullOrWhiteSpace(Session?.Provider) ? "S" : Session.Provider[..1].ToUpperInvariant();
    private string MachineLabel => Session is null ? "" : DashboardFormat.Machine(Session);
    private DashboardLogEntry[] SessionLogEntries => Logs.Where(entry => entry.SessionId == Session?.SessionId).OrderByDescending(entry => entry.Sequence).Take(4).ToArray();
}

