<section class="activity-board @(Live ? "" : "board-paused")" aria-labelledby="board-heading">
    <div class="board-heading">
        <div><h2 id="board-heading">Machines and sessions</h2><p>Grouped by recorded machine identity. Select a session to inspect it.</p></div>
    </div>
    <div class="station-grid">
        @foreach (var machine in Stations)
        {
            var sessions = Snapshot.Sessions.Where(session => session.MachineId == machine.MachineId).OrderBy(session => session.SessionId, StringComparer.Ordinal).ToArray();
            var machineRecorded = HasMachineIdentity(machine.MachineId);
            var enrolled = IsEnrolled(machine.MachineId);
            var directRoute = sessions.Any(session => session.Reachable);
            <article class="@(machineRecorded ? "machine-station" : "session-metadata-group")" @key="machine.MachineId">
                @if (!machineRecorded)
                {
                    <div class="metadata-group-heading"><h3>Sessions without machine information</h3><p>Machine identity was not recorded for these sessions. This group does not represent another computer.</p><span>@sessions.Length @(sessions.Length == 1 ? "session" : "sessions")</span></div>
                }
                else
                {
                <div class="station-mast">
                    <span class="station-beacon @(enrolled && machine.Reachable ? "reachable" : "")" aria-hidden="true">
                        <svg viewBox="0 0 80 72" class="outpost-glyph">
                            <path class="outpost-shadow" d="M8 49 40 32 72 49 40 67Z" />
                            <path class="outpost-base" d="M8 44 40 27 72 44 40 61Z" />
                            <path class="outpost-side" d="M8 44 40 61 40 67 8 50ZM40 61 72 44 72 50 40 67Z" />
                            <path class="outpost-tower" d="M28 27 40 20 52 27 52 45 40 52 28 45Z" />
                            <path class="outpost-roof" d="M28 27 40 20 52 27 40 34Z" />
                            <path class="outpost-window" d="M34 36 38 38 38 43 34 41ZM43 38 47 36 47 41 43 43Z" />
                            <path class="outpost-antenna" d="M40 20V10" />
                            <circle class="outpost-light" cx="40" cy="8" r="4" />
                        </svg>
                    </span>
                    <div class="station-name">
                        <h3 title="@machine.MachineId">@machine.Name</h3>
                        <span>@machine.SessionCount @(machine.SessionCount == 1 ? "session" : "sessions")</span>
                        @if (!enrolled) { <span class="station-registration" title="No node enrollment is recorded for this machine. This does not indicate whether the PC is online.">No node enrollment</span> }
                        else { <span class="station-registration" title="Freshness of the enrolled node's discovery heartbeat, separate from direct chat routes.">@(machine.Reachable ? "Node heartbeat current" : "No current node heartbeat")</span> }
                    </div>
                    <span class="station-status" title="Whether a session shown here has a direct chat route. MCP calls and inbox communication can still work without one; this does not indicate whether a model is running."><span class="status-dot @(directRoute ? "teal" : "neutral")" aria-hidden="true"></span><span>@(directRoute ? "Direct chat route available" : "No direct chat route")</span></span>
                </div>
                }
                <div class="station-sessions">
                    @foreach (var session in sessions)
                    {
                        <button type="button" @key="session.SessionId" title="@(session.Reachable ? "Direct chat route available: the hub can wake this chat. This does not indicate whether a model is running." : "No direct chat route: the hub has no current wake route for this chat. MCP calls and inbox communication can still work.")" class="session-node @(SelectedId == session.SessionId ? "selected" : "") @(IsPulsing(session.SessionId) ? "signal" : "")" aria-pressed="@(SelectedId == session.SessionId ? "true" : "false")" @onclick="() => OnSelect.InvokeAsync(session.SessionId)">
                            <span class="signal-trail" aria-hidden="true"></span>
                            <span class="session-token" aria-hidden="true"><span class="token-initials">@SessionTokenLetters(session)</span><span class="node-shape @(session.Reachable ? "teal" : "neutral")"></span></span>
                            <span class="node-copy"><strong>@session.Label</strong><span>@(string.IsNullOrWhiteSpace(session.Provider) ? "Session" : session.Provider)</span></span>
                            <span class="node-meta">@TrafficNote(session)<span class="visually-hidden">, @(session.Reachable ? "direct chat route available" : "no direct chat route")</span></span>
                        </button>
                    }
                    @if (sessions.Length == 0)
                    {
                        <p class="station-idle">No sessions.</p>
                    }
                </div>
            </article>
        }
        @if (Stations.Length == 0)
        {
            <div class="board-empty"><Icon Name="machine" Size="28" /><h3>No machines yet</h3><p>A machine appears when a chat on it opens a session.</p></div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public DashboardSnapshot Snapshot { get; set; } = new();
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public DateTimeOffset Now { get; set; }
    [Parameter] public bool Live { get; set; }
    [Parameter] public Func<string, bool> IsPulsing { get; set; } = _ => false;

    private bool IsEnrolled(string machineId) => Snapshot.Machines.Any(machine => machine.MachineId == machineId);
    private static bool HasMachineIdentity(string machineId) => !string.IsNullOrWhiteSpace(machineId);

    private static string SessionTokenLetters(DashboardSession session)
    {
        var name = !string.IsNullOrWhiteSpace(session.Label) ? session.Label : session.Provider ?? string.Empty;
        var letters = new string(name.Where(char.IsLetterOrDigit).Take(2).ToArray());
        return string.IsNullOrEmpty(letters) ? "S" : letters.ToUpperInvariant();
    }

    private string TrafficNote(DashboardSession session)
    {
        var latest = Snapshot.Traffic.Where(entry => entry.SessionId == session.SessionId).MaxBy(entry => entry.Sequence);
        if (latest is null) return session.LastActivityAt is null ? "No activity yet" : DashboardFormat.Ago(session.LastActivityAt, Now);
        var kind = latest.Kind.ToLowerInvariant() switch { "request" => "Request", "response" => "Response", "push" => "Push", _ => "Event" };
        return $"{kind} {DashboardFormat.Ago(latest.Timestamp, Now).ToLowerInvariant()}";
    }

    private DashboardMachine[] Stations => Snapshot.Machines
        .Concat(Snapshot.Sessions.Where(session => !Snapshot.Machines.Any(machine => machine.MachineId == session.MachineId))
            .GroupBy(session => session.MachineId)
            .Select(group => new DashboardMachine { MachineId = group.Key, Name = DashboardFormat.Machine(group.First()), SessionCount = group.Count(), Reachable = group.Any(session => session.Reachable) }))
        .OrderBy(machine => machine.MachineId, StringComparer.Ordinal).ToArray();
}

