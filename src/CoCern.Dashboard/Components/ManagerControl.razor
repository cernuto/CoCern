@if (Compact)
{
    <section class="dispatch-strip" aria-label="Dispatch controls">
        <strong>Dispatch: @(Paused is true ? "Paused" : Paused is false ? "Running" : "Not yet read")</strong>
        <span class="dispatch-repository">@(NeedsRepository ? "Choose a repository on Manager" : RepositoryId)</span>
        <div class="dispatch-actions">
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" OnClick='() => DispatchAsync("pause")' Disabled="@(DispatchBusy || NeedsRepository)" AriaLabel="Pause dispatch">Pause</BbButton>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" OnClick='() => DispatchAsync("stop")' Disabled="@(DispatchBusy || NeedsRepository)" AriaLabel="Request stop for all chats" title="Prevents new work and asks known chats to cancel; running tools and wake delivery continue.">Stop</BbButton>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" OnClick='() => DispatchAsync("resume")' Disabled="@(DispatchBusy || NeedsRepository)" AriaLabel="Resume dispatch">Resume</BbButton>
            <BbButton Href="manager" Variant="ButtonVariant.Ghost">Manager</BbButton>
        </div>
        @if (DispatchMessage is not null) { <p role="status">@DispatchMessage</p> }
        @if (UnconfirmedDecision is not null)
        {
            <p role="status">A manager decision is unconfirmed. Open Manager to review its saved request and retry.</p>
        }
        @if (UnconfirmedDispatch is not null)
        {
            <p>Unconfirmed dispatch: @UnconfirmedDispatch.Command.</p>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" OnClick="RetryDispatchAsync" Disabled="@DispatchBusy">Retry dispatch</BbButton>
        }
    </section>
}
else
{
<BbCard role="region" Class="surface sql-view standing-view" aria-labelledby="manager-heading">
    <h2 id="manager-heading">@RecoveryPanelKind</h2>
    <p>Pause prevents new claims and actions. Stop also asks known chats to cancel. Running tools and wake delivery are not interrupted.</p>
    <div class="standing-section">
        <div class="close-sessions-repository">
            <label for="manager-repository">Repository</label>
            <BbInput Type="InputType.Text" Id="manager-repository" Value="@RepositoryId" ValueChanged="@(value => RepositoryId = value ?? string.Empty)" UpdateTiming="UpdateTiming.Immediate" maxlength="256" Disabled="@(DecisionBusy || UnconfirmedDecision is not null)" />
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick="RefreshAsync" Disabled="@(ReadBusy || NeedsRepository)">Refresh selection</BbButton>
        </div>
        @if (NeedsRepository) { <p class="close-sessions-note">@RepositoryRequired</p> }
        <p>Dispatch: @(Paused is true ? "Paused" : Paused is false ? "Running" : "Not yet read")</p>
        <div class="close-sessions-actions">
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick='() => DispatchAsync("pause")' Disabled="@(DispatchBusy || NeedsRepository)">Pause dispatch</BbButton>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Destructive" Class="connect-button" OnClick='() => DispatchAsync("stop")' Disabled="@(DispatchBusy || NeedsRepository)">Request stop for all chats</BbButton>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick='() => DispatchAsync("resume")' Disabled="@(DispatchBusy || NeedsRepository)">Resume dispatch</BbButton>
        </div>
        @if (DispatchMessage is not null) { <p role="status">@DispatchMessage</p> }
        @if (UnconfirmedDispatch is not null)
        {
            <p>Unconfirmed dispatch: @UnconfirmedDispatch.Command, request @UnconfirmedDispatch.RequestId.</p>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick="RetryDispatchAsync" Disabled="@DispatchBusy">Retry dispatch</BbButton>
        }
    </div>
    <section class="standing-section" aria-labelledby="manager-selection-heading">
        <h3 id="manager-selection-heading">Manager selection</h3>
        <p class="close-sessions-note">Each repository has its own managers, and a repository can have several at once. Adding a manager never removes the others, and nothing here changes another repository's managers. A manager chat can add or remove itself; adding or removing any other chat needs your words.</p>
        @if (Selection is null)
        {
            <p>Enter a repository and refresh selection.</p>
        }
        else
        {
            @if (Managers.Length == 0)
            {
                <p>No manager is currently appointed in this repository.</p>
                <p class="close-sessions-note">A chat's name does not appoint it. Choose the exact chat below to add it as a manager.</p>
            }
            else
            {
                <ul class="standing-records" aria-label="Current managers">
                    @foreach (var manager in Managers)
                    {
                        <li @key="manager.SessionId">
                            <p><strong>@(manager.Available ? "Manager" : "Manager unavailable")</strong> · @(Sessions.FirstOrDefault(session => session.SessionId == manager.SessionId && session.RepositoryId == manager.RepositoryId)?.Label ?? "Session label unavailable")</p>
                            <p>Session @manager.SessionId · Repository @manager.RepositoryId · Added at generation @manager.Generation</p>
                            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Destructive" Class="admin-destructive" OnClick='() => DecideAsync("clear_manager", manager.SessionId)' Disabled="@(DecisionBusy || UnconfirmedDecision is not null)" AriaLabel="@($"Remove manager {manager.SessionId}")">Remove</BbButton>
                        </li>
                    }
                </ul>
            }
            <p>Generation @Selection.Generation</p>
        }
        <div class="close-sessions-repository">
            <label for="manager-target">Observed session</label>
            <BbNativeSelect TValue="string" Id="manager-target" Value="@TargetSessionId" ValueChanged="@(value => ChooseTargetAsync(value ?? string.Empty))" Disabled="@(DecisionBusy || UnconfirmedDecision is not null)">
                <option value="">Choose a session</option>
                @foreach (var session in Sessions)
                {
                    <option value="@session.SessionId">@session.Label · @(string.IsNullOrWhiteSpace(session.MachineName) ? (string.IsNullOrWhiteSpace(session.MachineId) ? "PC not reported" : session.MachineId) : session.MachineName) · @session.SessionId · @session.RepositoryId</option>
                }
            </BbNativeSelect>
        </div>
        <div class="close-sessions-repository">
            <label for="manager-target-id">Exact session ID</label>
            <BbInput Type="InputType.Text" Id="manager-target-id" Value="@TargetSessionId" ValueChanged="@(value => ChooseTargetAsync(value ?? string.Empty))" UpdateTiming="UpdateTiming.Immediate" Disabled="@(DecisionBusy || UnconfirmedDecision is not null)" />
        </div>
        <p class="close-sessions-note">An exact ID of a listed chat switches to its repository. If the chat is missing from the list, enter its exact ID and repository.</p>
        @if (TargetSessionId.Length > CoCern.Contracts.RelayLimits.MaxIdentifierLength) { <p role="alert">The exact session ID exceeds 256 characters.</p> }
        @if (!string.IsNullOrWhiteSpace(TargetSessionId))
        {
            <p>Target: Session @TargetSessionId · Repository @RepositoryId</p>
        }
        <p>Enter the direct human answer authorizing this exact addition or removal. Selection records a choice; it grants no new powers.</p>
        @if (HumanWords.Length > 200) { <p id="manager-words-error" role="alert">The human answer exceeds 200 characters. Shorten it explicitly; the text has been kept in full.</p> }
        else if (HumanWords.Any(UnsafeCharacter)) { <p id="manager-words-error" role="alert">Enter one line. Edit the answer to remove line breaks or control characters.</p> }
        <div class="close-sessions-repository">
            <label for="manager-human-words">Exact human answer (up to 200 characters)</label>
            <BbTextarea Id="manager-human-words" rows="3" AriaInvalid="@(HumanWords.Length > 200 || HumanWords.Any(UnsafeCharacter))" AriaDescribedBy="manager-words-error" Value="@HumanWords" ValueChanged="@(value => HumanWords = value ?? string.Empty)" UpdateTiming="UpdateTiming.Immediate" Disabled="@(DecisionBusy || UnconfirmedDecision is not null)" />
        </div>
        <div class="close-sessions-actions">
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick='() => DecideAsync("appoint_manager")' Disabled="@(DecisionBusy || UnconfirmedDecision is not null)">Add manager</BbButton>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Destructive" Class="admin-destructive" OnClick='() => DecideAsync("clear_manager")' Disabled="@(DecisionBusy || UnconfirmedDecision is not null)">Remove all managers</BbButton>
        </div>
        @if (Message is not null) { <p role="status">@Message</p> }
        @if (UnconfirmedDecision is not null)
        {
            <p>Unconfirmed request @UnconfirmedDecision.RequestId · @(UnconfirmedDecision.Command == "appoint_manager" ? "Add" : UnconfirmedDecision.TargetSessionId is null ? "Remove all" : "Remove")@(UnconfirmedDecision.TargetSessionId is { } decided ? " session " + decided : "") · Generation @UnconfirmedDecision.ExpectedManagerGeneration</p>
            <blockquote class="standing-record-text">@UnconfirmedDecision.HumanWords</blockquote>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick="RetryDecisionAsync" Disabled="@DecisionBusy">Retry decision</BbButton>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick="NewDecision" Disabled="@DecisionBusy">Start a new decision</BbButton>
        }
        <h3>Recent manager selections</h3>
        <p>This bounded list records recent selections.</p>
        @if (RecentSelections.Length == 0) { <p>No selection history loaded.</p> }
        <ul class="standing-records">
            @foreach (var decision in RecentSelections)
            {
                <li @key="decision.Generation">
                    <p>Generation @decision.Generation · @(decision.SessionId is not null ? "Added" : "Removed") · @decision.RepositoryId · Session @(decision.SessionId ?? decision.PreviousSessionId ?? "None")@(decision.SessionId is not null && decision.PreviousSessionId is { } moved ? " (replacing session " + moved + ")" : "")</p>
                    <blockquote class="standing-record-text">@decision.HumanWords</blockquote>
                    <p>By @decision.ActorPrincipalId at <time datetime="@decision.At.ToString("O")">@DashboardFormat.Timestamp(decision.At)</time> · Request @decision.RequestId@(decision.RecordedBySessionId is { } recorder ? " · Recorded by chat " + recorder : "")</p>
                </li>
            }
        </ul>
        @if (nextHistoryBefore is not null)
        {
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick="LoadEarlierAsync" Disabled="@ReadBusy">Load earlier decisions</BbButton>
        }
        <h3>Recent administrative actions</h3>
        <p>Administrative calls in this repository, from chats and from this dashboard: who, what, on what and how each ended. A session or manager generation appears only when the hub verified it.@(ActionsDropped > 0 ? $" {ActionsDropped} older entries are no longer kept." : "")</p>
        @if (RecentActions.Length == 0) { <p>No actions loaded.</p> }
        <ul class="standing-records">
            @foreach (var action in RecentActions)
            {
                <li @key="action.Seq">
                    <p>@action.Tool@(action.Command is { } command ? " " + command : "")@(action.Target is { } target ? " · " + target : "") · @(action.Succeeded ? "Done" : "Refused: " + action.Code)</p>
                    <p>By @action.ActorPrincipalId@(action.ActingSessionId is { } session ? " · Chat " + session : "")@(action.ManagerGeneration is { } generation ? $" · As manager, generation {generation}" : "") at <time datetime="@action.At.ToString("O")">@DashboardFormat.Timestamp(action.At)</time>@(action.DecisionRef is { } decisionRef ? " · " + decisionRef : "")</p>
                </li>
            }
        </ul>
        @if (nextActionsBefore is not null)
        {
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Class="close-sessions-secondary" OnClick="LoadEarlierActionsAsync" Disabled="@ReadBusy">Load earlier actions</BbButton>
        }
    </section>
</BbCard>
}
@code {
    private bool NeedsRepository => string.IsNullOrWhiteSpace(RepositoryId);
    private string RecoveryPanelKind => "Manager and dispatch";
}
