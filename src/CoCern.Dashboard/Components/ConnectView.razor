@using System.Net.Http.Json
@inject HttpClient Http

@if (Compact)
{
    if (_status?.Clients.Any(NeedsSetup) == true)
    {
        <a class="surface connect-prompt" href="connect"><Icon Name="plug" Size="20" /><span><strong>Connect and verify your apps</strong><small>@SetupPromptDetail</small></span><span aria-hidden="true">→</span></a>
    }
}
else
{
    <BbCard role="region" Class="surface connect-view" aria-labelledby="connect-heading">
        <div class="section-heading"><div><h2 id="connect-heading">Apps on this PC</h2><p>Choose an app to connect to CoCern.</p></div></div>
        @if (_status is null)
        {
            <p class="empty-copy">Looking for apps…</p>
        }
        else if (_status.Unavailable is { } reason)
        {
            <p class="empty-copy">@reason</p>
            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Disabled="@(_busy is not null)" OnClick="RefreshReadinessAsync">@(_busy == "refresh" ? "Checking…" : "Try again")</BbButton>
        }
        else
        {
            <ul class="connect-list">
                @foreach (var client in _status.Clients)
                {
                    <li class="connect-item" @key="client.Id">
                        <span class="provider-token" aria-hidden="true">@client.Name[..1]</span>
                        <div><strong>@client.Name</strong><small>@Describe(client)</small></div>
                        @if (client.Id == ConnectClients.Codex && client.State != ConnectStates.OtherHub)
                        {
                            <BbBadge Variant="@(IsReady(client) ? BadgeVariant.SoftSuccess : BadgeVariant.Secondary)" Class="connection-state">@CodexStatus(client)@(client.Admin == true ? " · admin tools" : "")</BbBadge>
                            <section class="codex-readiness" aria-label="Codex connection" aria-busy="@(_busy is not null)">
                                @if (!IsReady(client))
                                {
                                    <p class="codex-next-step" role="status">@CodexNextStep(client)</p>
                                    <div class="codex-readiness-actions">
                                        @if (NativeInstalled(client.Readiness) && client.State is not (ConnectStates.Available or ConnectStates.Outdated or ConnectStates.Error))
                                        {
                                            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Default" Disabled="@(_busy is not null)" OnClick="RefreshReadinessAsync">@(_busy == "refresh" ? "Checking…" : "Check connection")</BbButton>
                                        }
                                        else
                                        {
                                            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Default" Disabled="@(_busy is not null)" OnClick="() => ConnectAsync(client.Id)">@(_busy == client.Id ? "Connecting…" : CodexConnectLabel(client))</BbButton>
                                        }
                                    </div>
                                }
                                <details class="codex-setup-details">
                                    <summary>@(IsStandardConnection(client.Readiness) ? "Connection details" : "Setup details")</summary>
                                    <p class="codex-readiness-summary">@(client.State is ConnectStates.Available or ConnectStates.Outdated or ConnectStates.Error ? CodexNextStep(client) : client.Readiness?.Summary ?? "Codex setup has not been verified yet.")</p>
                                @if (IsStandardConnection(client.Readiness))
                                {
                                    <p class="codex-readiness-detail">@CodexNextStep(client)</p>
                                    @if (client.Readiness?.SkillInstalled == true)
                                    {
                                        <p class="codex-readiness-detail">The CoCern workflow skill guides chats through tasks and coordination.</p>
                                    }
                                }
                                else
                                {
                                <ol class="codex-readiness-steps">
                                    <li><span class="readiness-marker" aria-hidden="true">@(client.Readiness is { HooksInstalled: true, SkillInstalled: true } ? "✓" : "1")</span><div><strong>Existing native setup</strong><small>@(client.Readiness is { HooksInstalled: true, SkillInstalled: true } ? "Native hooks and the CoCern workflow skill are installed." : "Native hooks are managed separately. Updating the connection does not install them.")</small></div></li>
                                    <li><span class="readiness-marker" aria-hidden="true">@(client.Readiness?.StartupObserved == true ? "✓" : "2")</span><div><strong>Review hooks and use CoCern</strong><small>@(client.Readiness?.StartupObserved == true ? "A genuine CoCern hook was received." : "In Codex, review the CoCern hooks if needed, then use a CoCern tool. This chat joins automatically on its first call.")</small></div></li>
                                    <li><span class="readiness-marker" aria-hidden="true">@(client.Readiness?.SessionVerified == true ? "✓" : "3")</span><div><strong>Verify the session</strong><small>@(client.Readiness?.SessionVerified == true ? "The native session and repository were verified with the hub." : "CoCern verifies the captured chat identity and resolves the repository automatically.")</small></div></li>
                                    <li><span class="readiness-marker" aria-hidden="true">@(client.Readiness?.WakeReady == true ? "✓" : "4")</span><div><strong>Check the wake route</strong><small>@(client.Readiness?.WakeReady == true ? "The session can receive CoCern wake notifications." : "Keep Codex and the local CoCern node running so the session can receive attention.")</small></div></li>
                                </ol>
                                @if (client.Readiness?.Detail is { Length: > 0 } detail)
                                {
                                    <p class="codex-readiness-detail">@detail</p>
                                }
                                @if (client.Readiness?.CapturedAt is { } capturedAt)
                                {
                                    <p class="codex-readiness-detail"><strong>Last observed startup:</strong> <time datetime="@capturedAt.ToString("O")">@capturedAt.ToLocalTime().ToString("g") (local time)</time></p>
                                }
                                @if (client.Readiness is { SessionVerified: true } verified)
                                {
                                    <dl class="codex-verified-session"><div><dt>Repository</dt><dd>@(verified.RepositoryId ?? "Verified")</dd></div><div><dt>Session</dt><dd>@(verified.SessionId ?? "Verified")</dd></div></dl>
                                }
                                <div class="codex-readiness-actions">
                                    @if (NativeInstalled(client.Readiness))
                                    {
                                        <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Disabled="@(_busy is not null)" OnClick="() => ConnectAsync(client.Id)">@(_busy == client.Id ? "Updating…" : "Update connection")</BbButton>
                                    }
                                    @if (IsReady(client) || !NativeInstalled(client.Readiness))
                                    {
                                        <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Disabled="@(_busy is not null)" OnClick="RefreshReadinessAsync">@(_busy == "refresh" ? "Checking…" : "Check connection")</BbButton>
                                    }
                                </div>
                                <p class="codex-readiness-footnote">Checks are read-only. Connection updates preserve native hooks and launch mode; hook approval stays in Codex.</p>
                                }
                                </details>
                            </section>
                        }
                        else if (client.State is ConnectStates.Connected or ConnectStates.Added)
                        {
                            <BbBadge Variant="BadgeVariant.SoftSuccess" Class="connection-state">@(client.State == ConnectStates.Added ? "Connected · restart it" : client.Admin == true ? "Connected · admin tools" : "Connected")</BbBadge>
                        }
                        else if (client.State != ConnectStates.OtherHub)
                        {
                            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Default" Class="connect-button" Disabled="@(_busy is not null)" OnClick="() => ConnectAsync(client.Id)">@(_busy == client.Id ? "Connecting…" : client.State == ConnectStates.Error ? "Try again" : "Connect")</BbButton>
                        }
                        @if (_checksFor == client.Id && _status.Checks.Length > 0)
                        {
                            <ul class="installation-checks">
                                @foreach (var check in _status.Checks)
                                {
                                    <li @key="check.Id"><div><strong>@check.Name</strong><p>@check.Detail</p></div><BbBadge Variant="@(check.State == "passed" ? BadgeVariant.SoftSuccess : BadgeVariant.Secondary)">@CheckLabel(check.State)</BbBadge></li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
            <details class="connect-permissions">
                <summary>App permissions</summary>
                <label class="admin-tools" for="connect-admin-tools">
                    <BbCheckbox Id="connect-admin-tools" Checked="@_admin" Disabled="@(_busy is not null)" CheckedChanged="@(value => ChooseAdminAsync(new ChangeEventArgs { Value = value }))" />
                    <span><strong>Administrator tools</strong><small>Allow connected chats to manage rules, orders and other sessions. Enable only for apps whose chats you trust.</small></span>
                </label>
                <p class="table-footnote">Existing permissions are kept unless you change this choice.</p>
            </details>
        }
    </BbCard>
}

@code {
    [Parameter] public bool Compact { get; set; }
    private DashboardConnectStatus? _status;
    private string? _busy;
    // The app whose installation checks _status carries: the last one connected here.
    private string? _checksFor;
    // Starts ticked when every configured app has administrator tools. Preserve each app's role until the user explicitly changes this choice.
    private bool _admin;
    private bool _adminChosen;

    protected override async Task OnInitializedAsync()
    {
        _status = await LoadAsync(() => Http.GetFromJsonAsync<DashboardConnectStatus>("api/connect"));
        var entries = _status?.Clients.Where(client => client.Admin is not null).ToArray() ?? [];
        _admin = entries.Length > 0 && entries.All(client => client.Admin == true);
    }

    private string Choice => _adminChosen ? $"?admin={(_admin ? "true" : "false")}" : "";

    private async Task ChooseAdminAsync(ChangeEventArgs change)
    {
        _admin = change.Value is true;
        _adminChosen = true;
        _busy = "";
        _status = await LoadAsync(() => Http.GetFromJsonAsync<DashboardConnectStatus>("api/connect" + Choice));
        _busy = null;
    }

    private async Task RefreshReadinessAsync()
    {
        _busy = "refresh";
        _status = await LoadAsync(() => Http.GetFromJsonAsync<DashboardConnectStatus>("api/connect" + Choice));
        _busy = null;
    }

    private static bool IsStandardConnection(DashboardCodexReadiness? readiness) => readiness?.State == "standard";

    private static bool IsReady(DashboardConnectClient client) => (client.State is ConnectStates.Connected or ConnectStates.Added or ConnectStates.Updated) && client.Readiness?.State != "error" && (IsStandardConnection(client.Readiness) || client.Readiness is { HooksInstalled: true, SkillInstalled: true, StartupObserved: true, SessionVerified: true, WakeReady: true });

    private static bool NativeInstalled(DashboardCodexReadiness? readiness) => readiness is { HooksInstalled: true, SkillInstalled: true };

    private static bool NeedsConnectionUpdate(DashboardConnectClient client) => client.State == ConnectStates.Outdated || client.State == ConnectStates.Available && (IsStandardConnection(client.Readiness) || client.Detail is { Length: > 0 });

    private static string CodexConnectLabel(DashboardConnectClient client) => client.State == ConnectStates.Error ? "Try again" : NeedsConnectionUpdate(client) || client.State is ConnectStates.Connected or ConnectStates.Added or ConnectStates.Updated ? "Update connection" : "Connect Codex";

    private static string CodexStatus(DashboardConnectClient client) => client.State == ConnectStates.Error || client.Readiness?.State == "error" ? "Needs attention" : NeedsConnectionUpdate(client) ? "Update required" : client.State == ConnectStates.Available ? "Connection required" : IsStandardConnection(client.Readiness) && IsReady(client) ? "Connected · standard connection" : IsReady(client) ? "Native startup verified" : !NativeInstalled(client.Readiness) ? "Native setup needs attention" : client.Readiness?.StartupObserved != true ? "Finish in Codex" : "Needs verification";

    private static string CodexNextStep(DashboardConnectClient client) => client.State switch
    {
        _ when NeedsConnectionUpdate(client) => client.Detail is { Length: > 0 } detail ? $"Update the CoCern connection. {detail}" : "Update the CoCern connection, then open or resume a chat.",
        ConnectStates.Available => "Connect Codex to CoCern.",
        ConnectStates.Error => client.Detail ?? "Connect Codex again to repair its CoCern connection.",
        _ => ReadinessNextStep(client.Readiness)
    };

    private static string ReadinessNextStep(DashboardCodexReadiness? readiness) => readiness switch
    {
        { State: "standard", NextAction: { Length: > 0 } action } => action,
        { State: "standard" } => "Open or resume a chat to use CoCern.",
        { State: "error", NextAction: { Length: > 0 } action } => action,
        _ when !NativeInstalled(readiness) => "Review the existing native setup and its diagnostics. Updating the connection does not install or approve hooks.",
        { NextAction: { Length: > 0 } action } => action,
        _ => "Use a CoCern tool in your Codex chat, then check the connection."
    };

    private static bool NeedsSetup(DashboardConnectClient client) => client.State is ConnectStates.Available or ConnectStates.Outdated || client.Id == ConnectClients.Codex && client.State != ConnectStates.OtherHub && !IsReady(client);

    private string SetupPromptDetail => $"Setup or startup verification needed for {string.Join(", ", _status?.Clients.Where(NeedsSetup).Select(client => client.Name) ?? [])}.";

    private async Task ConnectAsync(string id)
    {
        _busy = id;
        var result = await LoadAsync(async () =>
        {
            using var response = await Http.PostAsync($"api/connect/{id}{Choice}", null);
            return response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<DashboardConnectStatus>() : new DashboardConnectStatus { Unavailable = "Connecting is only possible from the hub's PC." };
        });
        _busy = null;
        // Keep the other apps' rows; replace only the one just connected. Its installation checks show under it.
        _checksFor = id;
        if (result?.Unavailable is null && _status is { Unavailable: null } && result?.Clients is [var changed])
            _status = _status with { Clients = _status.Clients.Select(client => client.Id == changed.Id ? changed : client).ToArray(), Checks = result.Checks };
        else _status = result;
    }

    private static string CheckLabel(string state) => state switch
    { "passed" => "Passed", "needs_repair" => "Needs repair", "warning" => "Action needed", _ => "Unavailable" };

    private static async Task<DashboardConnectStatus?> LoadAsync(Func<Task<DashboardConnectStatus?>> load)
    {
        try { return await load() ?? new DashboardConnectStatus { Unavailable = "The hub did not answer. Reload to try again." }; }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { return new DashboardConnectStatus { Unavailable = "The hub did not answer. Reload to try again." }; }
    }

    private static string Describe(DashboardConnectClient client) => client.State switch
    {
        ConnectStates.Error => client.Detail ?? "Its settings could not be changed.",
        ConnectStates.Available when client.Detail is { } detail => detail,
        ConnectStates.OtherHub => client.Detail ?? "Its CoCern entry points at another hub, so Connect leaves it as it is.",
        _ => client.Id switch { ConnectClients.ClaudeCode => "The Claude Code CLI and its IDE extensions.", ConnectClients.ClaudeDesktop => "Claude for desktop.", ConnectClients.Codex => "Codex CLI, IDE extension and app.", _ => "" }
    };
}
