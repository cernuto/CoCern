<BbCard role="region" Class="surface document-inventory" aria-labelledby="docs-heading">
    <div class="section-heading"><div><h2 id="docs-heading">Documents</h2><p>Usage for files discovered in each repository. Expand a repository to see its files.</p></div></div>
    @if (Cache.ObservedAt is null)
    {
        <p class="empty-copy">Waiting for the hub.</p>
    }
    else
    {
        @foreach (var directory in Cache.Grains.Where(grain => grain.Kind == "Directory"))
        {
            <details class="document-repository" open="@IsFirstRepository(directory)">
                <summary class="document-repository-heading"><span class="document-repository-name">@directory.Repository</span><span>@directory.Documents.ToString("N0") @(directory.Documents == 1 ? "document" : "documents")</span></summary>
                <ul class="document-file-list">
                    @foreach (var path in directory.DocumentPaths)
                    {
                        var usage = directory.DocumentUsage.GetValueOrDefault(path);
                        <li class="document-file">
                            <div class="document-file-identity"><strong>@DocumentName(path)</strong><small>@path</small></div>
                            <dl class="document-usage">
                                <div><dt title="Completed document searches, including searches with no matches.">Searches</dt><dd>@UsageCount(usage?.Searches)</dd></div>
                                <div><dt title="Matching sections found in this file before the combined search result limit.">Matches found</dt><dd>@UsageCount(usage?.MatchedSections)</dd></div>
                                <div><dt title="Successful section reads; source reads for the cache are shown separately below.">Section reads</dt><dd>@UsageCount(usage?.SectionReads)</dd></div>
                                <div><dt>Last used</dt><dd title="@(usage?.LastUsedAt is null ? null : DashboardFormat.Timestamp(usage.LastUsedAt))">@(usage is null ? "Not recorded" : usage.LastUsedAt is null ? "No use recorded" : DashboardFormat.Ago(usage.LastUsedAt, Now))</dd></div>
                            </dl>
                            <p class="document-tracking">@(usage is null ? "Tracking period not recorded." : $"Tracked since {DashboardFormat.Timestamp(usage.TrackingSince)} (local time).")</p>
                        </li>
                    }
                </ul>
                @if (directory.Documents == 0)
                {
                    <p class="document-inventory-note">No documents found in this repository.</p>
                }
                else if (directory.DocumentPaths.Length < directory.Documents)
                {
                    <p class="document-inventory-note">Showing @directory.DocumentPaths.Length of @directory.Documents documents in this update.</p>
                }
            </details>
        }
        @if (!Cache.Grains.Any(grain => grain.Kind == "Directory")) { <p class="empty-copy">No repository document inventories reported yet.</p> }
        <p class="document-usage-note">Searches count completed checks of a file, including zero-match searches. Matches found are matching sections, which may not have been returned or read. Section reads count successful section responses. Counts cover the tracking period shown; Not recorded means no usage history is available.</p>
        @if (Cache.Truncated) { <p class="table-footnote">Some repository inventories may be omitted from this update.</p> }
    }
</BbCard>

<BbCard role="region" Class="surface doc-cache-view" aria-labelledby="indexes-heading">
    <div class="section-heading"><div><h2 id="indexes-heading">Index activity</h2><p>@Cache.ActiveDirectories @(Cache.ActiveDirectories == 1 ? "repository index" : "repository indexes") · @Cache.ActiveDocuments @(Cache.ActiveDocuments == 1 ? "document index" : "document indexes") active. Source reads and index builds describe cache work for the current activation.</p></div></div>
    @if (Cache.ObservedAt is null)
    {
        <p class="empty-copy">Waiting for the hub.</p>
    }
    else
    {
        <p class="muted" title="@DashboardFormat.Timestamp(Cache.ObservedAt)">Updated @DashboardFormat.Ago(Cache.ObservedAt, Now).ToLowerInvariant()</p>
        @if (Cache.Grains.Length > 0)
        {
        <details class="document-index-details">
            <summary>View active index diagnostics</summary>
        <div class="doc-cache-table">
            <table class="metrics-table">
                <caption class="visually-hidden">Loaded repository and document indexes</caption>
                <thead><tr><th scope="col">Document / repository</th><th scope="col">Kind</th><th scope="col">State</th><th scope="col">Sections</th><th scope="col">Source reads</th><th scope="col">Index builds</th><th scope="col">Commit</th><th scope="col">Activated</th></tr></thead>
                <tbody>
                    @foreach (var grain in Cache.Grains)
                    {
                        <tr>
                            <th scope="row"><strong>@(grain.Kind == "Directory" ? grain.Repository : System.IO.Path.GetFileName(grain.Path.Replace('\\', '/')))</strong><small>@(grain.Kind == "Directory" ? "Repository index" : grain.Repository)</small>@if (grain.Kind != "Directory") { <small>@grain.Path</small> }</th>
                            <td>@grain.Kind</td>
                            <td>@(grain.Kind == "Directory" ? $"{grain.Documents} documents" : grain.Loaded ? "Loaded" : "Not loaded")</td>
                            <td class="numeric">@(grain.Kind == "Directory" ? "—" : grain.Sections.ToString("N0"))</td>
                            <td class="numeric">@(grain.Kind == "Directory" ? "—" : grain.Reads.ToString("N0"))</td>
                            <td class="numeric">@(grain.Kind == "Directory" ? "—" : grain.IndexRuns.ToString("N0"))</td>
                            <td title="@grain.Commit">@(grain.Commit.Length == 0 ? "—" : grain.Commit[..Math.Min(8, grain.Commit.Length)])</td>
                            <td title="@DashboardFormat.Timestamp(grain.ActivatedAt)">@DashboardFormat.Ago(grain.ActivatedAt, Now)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </details>
        }
        @if (Cache.Grains.Length == 0 && !Cache.Truncated) { <p class="empty-copy">Nothing loaded. Indexes load when an agent searches or reads documents, and unload when idle.</p> }
        @if (Cache.Truncated) { <p class="limit-note">Showing @Cache.Grains.Length of @(Cache.ActiveDirectories + Cache.ActiveDocuments).</p> }
    }
</BbCard>

@code {
    [Parameter, EditorRequired] public DashboardDocCache Cache { get; set; } = new();
    [Parameter] public DateTimeOffset Now { get; set; }

    // The page re-renders every second and gets a new snapshot every two; up to a few hundred documents are redrawn only when what they
    // show changed (see DocCacheRender).
    private int _key;
    private int? _shown;

    protected override void OnParametersSet() => _key = DocCacheRender.Key(Cache, Now);

    protected override bool ShouldRender() => _key != _shown;

    protected override void OnAfterRender(bool firstRender) => _shown = _key;

    private bool IsFirstRepository(DashboardDocGrain directory) =>
        directory == Cache.Grains.FirstOrDefault(grain => grain.Kind == "Directory" && grain.Documents > 0);

    private static string DocumentName(string path) => System.IO.Path.GetFileName(path.Replace('\\', '/'));

    private static string UsageCount(long? value) => value?.ToString("N0") ?? "Not recorded";
}
