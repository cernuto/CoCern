@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JavaScript

<section class="surface connect-view" aria-labelledby="add-pc-heading">
    <div class="section-heading"><div><h2 id="add-pc-heading">Add another PC</h2><p>Its chats can then message chats here. Do this once per PC.</p></div></div>
    @if (_status is null)
    {
        <p class="empty-copy">Getting the details…</p>
    }
    else if (_status.Unavailable is { } reason)
    {
        <p class="empty-copy">@reason</p>
    }
    else
    {
        @if (_status.Warning is { } warning)
        {
            <p class="warning-note" role="status">@warning</p>
        }
        <ol class="join-steps">
            <li>
                <strong>On the other PC, open PowerShell and paste this.</strong>
                <div class="copy-field"><code>@First.Command</code><button type="button" class="copy-button" @onclick="() => CopyAsync(First.Command, First.Url)">@Label(First.Url)</button></div>
                <small>It downloads CoCern from this hub, joins it, and adds CoCern to Claude Code and Codex there; the PC then shows up under Machines.</small>
            </li>
        </ol>
        <details class="join-help">
            <summary>The other PC can't reach the hub?</summary>
            <p>Allow the hub's port on private networks. Run this once on this PC, in PowerShell as administrator:</p>
            <div class="copy-field"><code>@_status.FirewallCommand</code><button type="button" class="copy-button" @onclick="() => CopyAsync(_status.FirewallCommand!, FirewallKey)">@Label(FirewallKey)</button></div>
            @if (_status.Addresses.Length > 1)
            {
                <p>If the PC name doesn't resolve, paste the command for one of this hub's addresses instead:</p>
                @foreach (var address in _status.Addresses.Skip(1))
                {
                    <p class="address-choice">@address.Url</p>
                    <div class="copy-field"><code>@address.Command</code><button type="button" class="copy-button" @onclick="() => CopyAsync(address.Command, address.Url)">@Label(address.Url)</button></div>
                }
            }
        </details>
        <p class="table-footnote">The command holds this hub's join code. Share it only with PCs you trust.</p>
    }
</section>

@code {
    private const string FirewallKey = "firewall";
    private DashboardAddPcStatus? _status;
    private string? _copied;

    /// <summary>The address by this PC's name: the hub lists it first, and it is the one a PC on the same network can usually resolve.</summary>
    private DashboardHubAddress First => _status!.Addresses[0];

    protected override async Task OnInitializedAsync()
    {
        try { _status = await Http.GetFromJsonAsync<DashboardAddPcStatus>("api/add-pc"); }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
        _status ??= new() { Unavailable = "The hub did not answer. Reload to try again." };
        if (_status.Unavailable is null && _status.Addresses.Length == 0) _status = _status with { Unavailable = "This PC has no network address other PCs could use." };
    }

    private async Task CopyAsync(string text, string which) => _copied = await JavaScript.InvokeAsync<bool>("pkDashboard.copy", text) ? which : null;

    /// <summary>"Copied" on the button just used, so the viewer knows which value is on the clipboard.</summary>
    private string Label(string which) => _copied == which ? "Copied" : "Copy";
}
