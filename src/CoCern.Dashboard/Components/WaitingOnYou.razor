<section class="waiting-on-you" aria-labelledby="@HeadingId">
    <h2 id="@HeadingId">Waiting on you</h2>
    @if (Waiting.Count == 0 && Waiting.Items.Length == 0)
    {
        <p class="muted">@(Waiting.Truncated ? "No pending decisions reported in this update." : "No pending decisions.")</p>
    }
    @foreach (var group in new[] { (Rows: Waiting.Items, Maybe: false), (Rows: Waiting.Maybe, Maybe: true) })
    {
        @if (group.Maybe && (Waiting.MaybeCount > 0 || group.Rows.Length > 0))
        {
            <h3>Chat reports and follow-up <span class="muted">@Waiting.MaybeCount</span></h3>
            <p class="muted">Informational updates; these do not confirm that your input is needed.</p>
        }
        @if (group.Rows.Length > 0)
        {
            <ul class="waiting-items">
                @foreach (var item in group.Rows)
                {
                    <li>
                        <div class="waiting-item-heading">
                            <BbBadge Variant="@(group.Maybe ? BadgeVariant.Outline : BadgeVariant.SoftWarning)">@KindLabel(item.Kind)</BbBadge>
                            @if (!string.IsNullOrEmpty(item.SessionId))
                            {
                                <BbButton Variant="ButtonVariant.Link" Class="waiting-session" OnClick="() => OnSelectSession.InvokeAsync(item.SessionId)">@(string.IsNullOrEmpty(item.Label) ? "Open chat" : item.Label)</BbButton>
                            }
                            else if (!string.IsNullOrEmpty(item.Label)) { <strong>@item.Label</strong> }
                        </div>
                        <p class="waiting-text">@item.Text</p>
                        <div class="waiting-item-details">
                            @if (!string.IsNullOrEmpty(item.RepositoryId)) { <span>@item.RepositoryId@if (!string.IsNullOrEmpty(item.BoardId)) { <text> / @item.BoardId</text> }</span> }
                            @if (!string.IsNullOrEmpty(item.TaskId)) { <span>Task @item.TaskId</span> }
                            @if (item.Since is { } since) { <time datetime="@since.ToString("O")" title="@DashboardFormat.Timestamp(since)">@DashboardFormat.Ago(since, Now)</time> }
                            @if (item.Kind == DashboardWaitingKinds.StandingProposal) { <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="waiting-session" OnClick="() => OnOpenStanding.InvokeAsync()">Review proposal</BbButton> }
                        </div>
                    </li>
                }
            </ul>
        }
    }
    @if (Waiting.Truncated) { <p class="limit-note">This list may be incomplete. @Waiting.Count pending decisions were reported.</p> }
</section>
@code {
    [Parameter] public DashboardWaiting Waiting { get; set; } = new();
    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;
    [Parameter] public string HeadingId { get; set; } = "waiting-heading";
    [Parameter] public EventCallback<string> OnSelectSession { get; set; }
    [Parameter] public EventCallback OnOpenStanding { get; set; }

    private static string KindLabel(string kind) => kind switch
    {
        DashboardWaitingKinds.StandingProposal => "Standing proposal",
        DashboardWaitingKinds.HumanBlocker => "Human decision",
        DashboardWaitingKinds.SelfReport => "Chat reported",
        DashboardWaitingKinds.Unresponsive => "Unread chat messages",
        DashboardWaitingKinds.CoordinatorHold => "Coordinator hold",
        _ => "Update"
    };
}
