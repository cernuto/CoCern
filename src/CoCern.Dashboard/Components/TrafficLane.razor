<section class="surface traffic-lane @(Live ? "" : "traffic-disconnected")" aria-labelledby="traffic-heading">
    <div class="section-heading">
        <div><h2 id="traffic-heading">Traffic</h2><p>@TrafficDescription</p></div>
        <div class="traffic-controls">
            @if (SelectedSession is not null)
            {
                <BbButton Variant="@(_sessionOnly ? ButtonVariant.Secondary : ButtonVariant.Outline)" Class="@($"traffic-filter {(_sessionOnly ? "active" : "")}")" aria-pressed="@(_sessionOnly ? "true" : "false")" OnClick="ToggleSessionFilter">This session</BbButton>
            }
            <BbButton Variant="ButtonVariant.Outline" Class="traffic-pause" aria-pressed="@(_paused ? "true" : "false")" OnClick="TogglePause">@(_paused ? "Resume" : "Pause")</BbButton>
        </div>
    </div>
    <div class="traffic-legend"><span><i class="traffic-key request" aria-hidden="true"></i>Request</span><span><i class="traffic-key response" aria-hidden="true"></i>Response</span><span><i class="traffic-key push" aria-hidden="true"></i>Push</span><span><i class="traffic-key error" aria-hidden="true"></i>Error</span><span class="traffic-count">@VisibleEvents.Length shown</span></div>
    @if (_sessionOnly && SelectedSession is not null)
    {
        <p class="traffic-scope">Following @SelectedSession.Label</p>
    }
    <div class="traffic-stream" @onwheel="Pause" @ontouchmove="Pause" @onkeydown="PauseForScrollKey" tabindex="0" aria-label="Recent traffic. Scrolling or opening an event pauses it.">
        <table class="traffic-table">
            <caption class="visually-hidden">Tool traffic through the hub, newest first. Select an event to inspect its metadata.</caption>
            <thead><tr><th scope="col">No.</th><th scope="col">Time</th><th scope="col">Source</th><th scope="col">Destination</th><th scope="col">Type</th><th scope="col">Info</th></tr></thead>
            <tbody>
                @foreach (var entry in VisibleEvents)
                {
                    var inspecting = _selectedSequence == entry.Sequence;
                    <tr class="traffic-event @KindClass(entry.Kind) @(IsError(entry) ? "traffic-error" : "") @(IsNew(entry.Sequence) ? "traffic-arrival" : "") @(inspecting ? "inspecting" : "")" data-sequence="@entry.Sequence" @key="entry.Sequence" @onclick="() => Inspect(entry.Sequence)">
                        <td class="traffic-sequence">@entry.Sequence</td>
                        <td class="traffic-time"><time title="@DashboardFormat.Timestamp(entry.Timestamp)">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</time></td>
                        <td class="traffic-endpoint" title="@EndpointTitle(entry, true)">@TrafficSource(entry)</td>
                        <td class="traffic-endpoint" title="@EndpointTitle(entry, false)">@TrafficDestination(entry)</td>
                        <td class="traffic-kind"><BbBadge Variant="@(IsError(entry) ? BadgeVariant.SoftDestructive : BadgeVariant.Outline)">@KindLabel(entry.Kind)</BbBadge></td>
                        <td class="traffic-info"><span @onclick:stopPropagation="true"><BbButton Variant="ButtonVariant.Ghost" Class="traffic-inspect" aria-expanded="@(inspecting ? "true" : "false")" aria-controls="traffic-selected-event" AriaLabel="@($"Inspect {KindLabel(entry.Kind).ToLowerInvariant()} {entry.Name}, event {entry.Sequence}")" OnClick="() => Inspect(entry.Sequence)">@EventInfo(entry)</BbButton></span></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (VisibleEvents.Length == 0)
        {
            <p class="empty-copy">@(_sessionOnly ? "No recent traffic for this session." : "No recent traffic.")</p>
        }
    </div>
    @if (SelectedEvent is { } selected)
    {
        <div class="traffic-event-detail" id="traffic-selected-event" role="region" aria-label="Selected traffic event">
            <div class="traffic-detail-heading"><h3>Event @selected.Sequence · @KindLabel(selected.Kind)</h3><BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => Inspect(selected.Sequence)" AriaLabel="Close event details">Close</BbButton></div>
            <dl>
                <div><dt>Time</dt><dd>@selected.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff zzz")</dd></div>
                <div><dt>Source</dt><dd>@EndpointTitle(selected, true)</dd></div>
                <div><dt>Destination</dt><dd>@EndpointTitle(selected, false)</dd></div>
                <div><dt>Info</dt><dd>@EventInfo(selected)</dd></div>
                @if (selected.CorrelationId is not null) { <div><dt>Correlation</dt><dd>@selected.CorrelationId</dd></div> }
            </dl>
            @if (PairedEvent(selected) is { } paired)
            {
                <p class="traffic-pair">Matching @KindLabel(paired.Kind).ToLowerInvariant(): @EventInfo(paired)</p>
            }
            else if (selected.CorrelationId is not null)
            {
                <p class="traffic-pair">The matching event isn't shown.</p>
            }
        </div>
    }
    <p class="traffic-footnote">Latest 120 tool events through the hub. Metadata only; a stored send doesn't prove delivery.</p>
</section>

@code {
    [Parameter] public DashboardTrafficEvent[] Entries { get; set; } = [];
    [Parameter] public DashboardSession[] Sessions { get; set; } = [];
    [Parameter] public DashboardSession? SelectedSession { get; set; }
    [Parameter] public string InstanceId { get; set; } = "";
    [Parameter] public DateTimeOffset Now { get; set; }
    [Parameter] public bool Live { get; set; }

    private DashboardTrafficEvent[] _window = [];
    private readonly HashSet<long> _newEvents = [];
    private DateTimeOffset _arrivalAt;
    private string? _instanceId;
    private string? _filterSessionId;
    private long? _selectedSequence;
    private long _latestSequence;
    private bool _paused;
    private bool _sessionOnly;
    private string TrafficDescription => !Live ? "Waiting for the hub. Showing the last traffic seen." : _paused ? "Paused." : "Requests, responses and pushes as they happen.";
    private DashboardTrafficEvent[] VisibleEvents => _sessionOnly && SelectedSession is not null ? _window.Where(entry => entry.SessionId == SelectedSession.SessionId).ToArray() : _window;
    private DashboardTrafficEvent? SelectedEvent => VisibleEvents.FirstOrDefault(entry => entry.Sequence == _selectedSequence);

    protected override void OnParametersSet()
    {
        if (_instanceId != InstanceId)
        {
            _instanceId = InstanceId;
            _latestSequence = 0;
            _paused = false;
            _selectedSequence = null;
            _newEvents.Clear();
        }
        if (_sessionOnly && _filterSessionId != SelectedSession?.SessionId)
        {
            _paused = false;
            _selectedSequence = null;
        }
        _filterSessionId = SelectedSession?.SessionId;
        if (!_paused) UpdateWindow();
    }

    private void UpdateWindow()
    {
        var latest = Entries.OrderByDescending(entry => entry.Sequence).Take(120).ToArray();
        var lastSequence = latest.FirstOrDefault()?.Sequence ?? 0;
        if (lastSequence != _latestSequence)
        {
            _newEvents.Clear();
            if (_latestSequence > 0)
                foreach (var entry in latest.Where(entry => entry.Sequence > _latestSequence)) _newEvents.Add(entry.Sequence);
            _latestSequence = lastSequence;
            _arrivalAt = DateTimeOffset.UtcNow;
        }
        _window = latest;
    }

    private bool IsNew(long sequence) => Live && !_paused && Now - _arrivalAt < TimeSpan.FromSeconds(1.5) && _newEvents.Contains(sequence);
    private void Pause() => _paused = true;
    private void PauseForScrollKey(KeyboardEventArgs key)
    {
        if (key.Key is "ArrowUp" or "ArrowDown" or "PageUp" or "PageDown" or "Home" or "End") Pause();
    }

    private void TogglePause()
    {
        _paused = !_paused;
        if (!_paused)
        {
            _selectedSequence = null;
            UpdateWindow();
            _newEvents.Clear();
        }
    }

    private void Inspect(long sequence)
    {
        _selectedSequence = _selectedSequence == sequence ? null : sequence;
        _paused = true;
    }

    private void ToggleSessionFilter()
    {
        _sessionOnly = !_sessionOnly;
        _selectedSequence = null;
    }

    private DashboardTrafficEvent? PairedEvent(DashboardTrafficEvent entry) => entry.CorrelationId is null ? null : _window.FirstOrDefault(candidate => candidate.Sequence != entry.Sequence && candidate.CorrelationId == entry.CorrelationId);
    private string ClientLabel(string? id, bool full = false)
    {
        if (string.IsNullOrWhiteSpace(id)) return "Unknown client";
        var session = Sessions.FirstOrDefault(candidate => candidate.SessionId == id);
        var identity = full ? id : id[..Math.Min(8, id.Length)];
        if (session is null) return $"Session #{identity}";
        var machine = string.IsNullOrWhiteSpace(session.MachineName) ? session.MachineId : session.MachineName;
        if (!full) return $"{(string.IsNullOrWhiteSpace(machine) ? "Session" : machine)} #{identity}";
        return $"{session.Label}{(string.IsNullOrWhiteSpace(machine) ? "" : $" · {machine}")} #{identity}";
    }
    private string TrafficSource(DashboardTrafficEvent entry) => entry.Kind.ToLowerInvariant() switch { "request" => ClientLabel(entry.SessionId), "response" or "push" => "Hub", _ => "Unknown" };
    private string TrafficDestination(DashboardTrafficEvent entry) => entry.Kind.ToLowerInvariant() switch { "request" => "Hub", "response" or "push" => ClientLabel(entry.SessionId), _ => "Unknown" };
    private string EndpointTitle(DashboardTrafficEvent entry, bool source) => entry.Kind.ToLowerInvariant() switch
    {
        "request" => source ? ClientLabel(entry.SessionId, true) : "Hub",
        "response" or "push" => source ? "Hub" : ClientLabel(entry.SessionId, true),
        _ => "Unknown"
    };
    private static bool IsError(DashboardTrafficEvent entry) => entry.Kind.Equals("response", StringComparison.OrdinalIgnoreCase) && entry.Code is { Length: > 0 } code && !code.Equals("Ok", StringComparison.OrdinalIgnoreCase);
    private static string EventInfo(DashboardTrafficEvent entry) => entry.Name + (entry.Code is null ? "" : $" · {entry.Code}") + (entry.DurationMilliseconds is null ? "" : $" · {Duration(entry.DurationMilliseconds)}");
    private static string KindClass(string kind) => kind.ToLowerInvariant() switch { "response" => "response", "push" => "push", _ => "request" };
    private static string KindLabel(string kind) => kind.ToLowerInvariant() switch { "request" => "Request", "response" => "Response", "push" => "Push", _ => "Event" };
    private static string Duration(double? milliseconds) => milliseconds is null ? "—" : milliseconds < 1000 ? $"{milliseconds:0.#} ms" : $"{milliseconds / 1000:0.##} s";
}


