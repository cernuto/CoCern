<BbCard role="region" Class="surface sql-view" aria-labelledby="sql-heading">
    <div class="section-heading"><div><h2 id="sql-heading">Tables</h2></div></div>
    <dl class="database-summary"><div><dt>Provider</dt><dd>@Known(Metrics.Provider)</dd></div><div><dt>Database</dt><dd>@Known(Metrics.Name)</dd></div><div><dt>Allocated size</dt><dd>@DashboardFormat.Bytes(Metrics.SizeBytes)</dd></div>@if (Metrics.ArchivedTasks is { } archived) { <div><dt>Archived tasks</dt><dd>@archived.ToString("N0")</dd></div> }<div><dt>Collected</dt><dd title="@DashboardFormat.Timestamp(Metrics.ObservedAt)">@DashboardFormat.Ago(Metrics.ObservedAt, Now)</dd></div></dl>
    @if (!string.IsNullOrWhiteSpace(Metrics.Warning)) { <p class="warning-note" role="status">@Metrics.Warning</p> }
    <div class="sql-table-scroll" role="region" aria-label="Database tables" tabindex="0">
    <table class="metrics-table">
        <caption class="visually-hidden">Tables, row counts and sizes</caption>
        <thead><tr><th scope="col">Table</th><th scope="col">Rows</th><th scope="col">Count</th><th scope="col">Size</th></tr></thead>
        <tbody>
            @foreach (var table in Metrics.Tables.OrderBy(table => table.Schema).ThenBy(table => table.Name))
            {
                <tr><th scope="row">@if (!string.IsNullOrWhiteSpace(table.Schema)) { <small>@table.Schema</small> } @table.Name</th><td class="numeric">@DashboardFormat.Rows(table)</td><td><BbBadge Variant="BadgeVariant.Outline" Class="quality-label">@DashboardFormat.CountQuality(table.CountKind)</BbBadge></td><td class="numeric">@DashboardFormat.Bytes(table.SizeBytes)</td></tr>
            }
        </tbody>
    </table>
    </div>
    @if (Metrics.Tables.Length == 0) { <p class="empty-copy">No table sizes yet.</p> }
    @if (Metrics.Truncated) { <p class="limit-note">Some tables aren't shown.</p> }
    <p class="table-footnote">Allocated size includes unused space reserved for reuse. ≥ means at least that many rows. — means not measured.</p>
</BbCard>

@code {
    [Parameter, EditorRequired] public DatabaseMetrics Metrics { get; set; } = new();
    [Parameter] public DateTimeOffset Now { get; set; }
    private static string Known(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
