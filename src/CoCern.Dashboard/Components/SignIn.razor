<main class="sign-in-layout">
    <section class="sign-in-art" aria-label="CoCern">
        <div class="relay-mark">Co<span class="mark-signal" aria-hidden="true"></span></div>
        <p class="brand-name">CoCern</p>
        <h1>See what your<br />agents are doing.</h1>
        <p class="sign-in-description">Machines, sessions and hub activity, live. Read-only.</p>
        <div class="decorative-stations" aria-hidden="true"><span></span><i></i><span></span><i></i><span></span></div>
    </section>
    <section class="sign-in-panel">
        <div class="sign-in-form">
            <h2>Sign in</h2>
            <p>Paste your administrator token. On this machine it's in <code>data/local-client-token</code>.</p>
            <form @onsubmit="SignInAsync" @onsubmit:preventDefault>
                <label for="viewer-token">Token</label>
                <input id="viewer-token" type="password" autocomplete="off" spellcheck="false" autocapitalize="none" @bind="_token" @bind:event="oninput" disabled="@_busy" required />
                <p class="field-note">Used once, never saved. You stay signed in for 30 minutes.</p>
                @if (!string.IsNullOrEmpty(Notice))
                {
                    <p class="form-notice" role="alert">@Notice</p>
                }
                <button class="primary-button" type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_token))">@(_busy ? "Signing in…" : "Sign in")</button>
            </form>
            <p class="sign-in-footnote">Agent messages and inboxes are never shown.</p>
        </div>
    </section>
</main>

@code {
    [Parameter] public string? Notice { get; set; }
    [Parameter] public EventCallback<string> OnSignIn { get; set; }
    private string _token = "";
    private bool _busy;

    private async Task SignInAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_token)) return;
        var credential = _token;
        _token = "";
        _busy = true;
        try { await OnSignIn.InvokeAsync(credential); }
        finally { _busy = false; }
    }
}
