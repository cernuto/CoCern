<main class="sign-in-layout">
    <section class="sign-in-art" aria-label="CoCern">
        <img class="sign-in-logo" src="cocern-logo.png" alt="CoCern coordination logo" />
        <p class="brand-name">CoCern</p>
        <h1>Your coordination workspace.</h1>
        <p class="sign-in-description">Machines, sessions and hub activity, live. Connect Claude and Codex in one click.</p>
    </section>
    <section class="sign-in-panel">
        <BbCard Class="sign-in-form">
            <h2>Sign in</h2>
            <p>Open the sign-in link the hub prints when it starts, or paste your administrator token from <code>data/local-client-token</code>.</p>
            <form @onsubmit="SignInAsync" @onsubmit:preventDefault>
                <label for="viewer-token">Token</label>
                <BbInput Type="InputType.Password" Id="viewer-token" autocomplete="off" spellcheck="false" autocapitalize="none" Value="@_token" ValueChanged="@(value => _token = value ?? string.Empty)" UpdateTiming="UpdateTiming.Immediate" Disabled="@_busy" Required="true" />
                <p class="field-note">Your token is exchanged for a protected sign-in cookie.</p>
                <label class="remember-browser" for="remember-browser"><BbCheckbox Id="remember-browser" @bind-Checked="_rememberBrowser" Disabled="@(_busy || Options is null)" />Remember this browser</label>
                @if (Options is { } options)
                {
                    <p class="field-note">@(_rememberBrowser
                        ? $"Stay signed in for up to {options.RememberDays} {(options.RememberDays == 1 ? "day" : "days")}, including browser restarts."
                        : $"Stay signed in for up to {options.SessionHours} {(options.SessionHours == 1 ? "hour" : "hours")} in this browser session.")</p>
                }
                @if (!string.IsNullOrEmpty(Notice))
                {
                    <p class="form-notice" role="alert">@Notice</p>
                }
                <BbButton Type="ButtonType.Submit" Variant="ButtonVariant.Default" Class="primary-button" Disabled="@(_busy || Options is null || string.IsNullOrWhiteSpace(_token))">@(_busy ? "Signing in…" : "Sign in")</BbButton>
            </form>
            <p class="sign-in-footnote">Agent messages and inboxes are never shown.</p>
        </BbCard>
    </section>
</main>

@code {
    [Parameter] public string? Notice { get; set; }
    [Parameter] public DashboardLoginOptions? Options { get; set; }
    [Parameter] public EventCallback<DashboardLoginRequest> OnSignIn { get; set; }
    private string _token = "";
    private bool _busy;
    private bool _rememberBrowser;

    private async Task SignInAsync()
    {
        if (_busy || Options is null || string.IsNullOrWhiteSpace(_token)) return;
        var credential = _token;
        _token = "";
        _busy = true;
        try { await OnSignIn.InvokeAsync(new DashboardLoginRequest { Token = credential, RememberBrowser = _rememberBrowser }); }
        finally { _busy = false; }
    }
}
