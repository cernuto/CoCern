<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <EmbeddedResource Include="Dashboard/Baselines/database-efficiency-20261110.json" LogicalName="CoCern.Host.Dashboard.Baselines.database-efficiency-20261110.json" />
    <!-- The host must include the RCL's asset manifest; the standalone WASM reference only exports its own root assets. -->
    <PackageReference Include="BlazorBlueprint.Components" />
    <AssemblyMetadata Include="CoCern.DevelopmentAdapterSource" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../CoCern.Adapter/bin/$(Configuration)/$(TargetFramework)'))" />
    <ProjectReference Include="../CoCern.Core/CoCern.Core.csproj" />
    <ProjectReference Include="../CoCern.Storage/CoCern.Storage.csproj" />
    <ProjectReference Include="../CoCern.Analytics/CoCern.Analytics.csproj" />
    <!-- Debug startup snapshots the current adapter output and uses its development setup helpers. -->
    <ProjectReference Include="../CoCern.Adapter/CoCern.Adapter.csproj" />
    <ProjectReference Include="../CoCern.Dashboard/CoCern.Dashboard.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- The shared token counter (o200k). -->
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
  </ItemGroup>
  <!-- The bundled DuckDB sqlite extension, unpacked next to the hub for the runtime it is built for. -->
  <Import Project="DuckDbExtensions.targets" />
</Project>
